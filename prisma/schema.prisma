// Upfront Portal — data model
// Postgres via Supabase. Auth is handled by Supabase Auth; `User.id` mirrors
// the `auth.users.id` UUID so the app schema can stay in the `public` schema
// while Supabase owns credentials/sessions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  COORDINATOR
  TEACHER
  STUDENT
}

enum CourseLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum StudentStatus {
  ACTIVE
  PAUSED
  CANCELED
}

// The school's three receiving bank accounts — which one a given student's
// payments go into.
enum BankAccount {
  GABES
  JOE
  ASAAS
}

enum LessonStatus {
  SCHEDULED
  COMPLETED // OK - aula dada
  CANCELED_BY_STUDENT // CA
  NO_SHOW // NC
  CANCELED_BY_TEACHER // CP
  CANCELED_VACATION // CF - cancelamento por férias
  CANCELED_HOLIDAY // F - feriado
  MAKEUP // R - reposição
  POWER_OUTAGE // Faltou energia
  TECH_ISSUE // Problema técnico
  OTHER
  PAUSED // P - aluno suspendeu o curso
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  PAUSED // course paused that month — nothing owed, not late
}

enum NotificationType {
  LESSON_REMINDER
  HOMEWORK_AVAILABLE
  PAYMENT_DUE
  TEACHER_OBSERVATION
  GENERAL
}

enum LeadStage {
  LEAD
  TRIAL_CLASS
  ENROLLED
  ACTIVE_STUDENT
  FORMER_STUDENT
  LOST
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PROMOTE
  STATUS_CHANGE
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                String  @id @default(uuid()) // == auth.users.id in Supabase
  // Real contact email — optional, NOT unique (students/teachers can share
  // one family/school email; it's not used to log in for those two roles).
  email             String?
  // Login handle for STUDENT/TEACHER accounts, chosen by an admin. NULL for
  // ADMIN/COORDINATOR, which still log in with `email` below.
  username          String? @unique
  // Admin-chosen password for STUDENT/TEACHER accounts, encrypted at rest
  // (AES-256-GCM, key from CREDENTIALS_ENCRYPTION_KEY) so it can be viewed
  // again from the admin account — see src/lib/crypto.ts. NULL for
  // ADMIN/COORDINATOR, whose passwords are never stored, only hashed by
  // Supabase Auth.
  passwordEncrypted String?

  name        String
  role        Role
  avatarUrl   String?
  phone       String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  teacherProfile   TeacherProfile?
  studentProfile   StudentProfile?
  // Set only for an additional login belonging to a "grupo" student — see
  // StudentGroupMember. Null for every ordinary (individual) student,
  // teacher, and staff account.
  groupMemberOf    StudentGroupMember?
  notifications    Notification[]
  leadInteractions LeadInteraction[] @relation("InteractionAuthor")

  @@map("users")
}

// ---------------------------------------------------------------------------
// Academic structure
// ---------------------------------------------------------------------------

model Course {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  students  StudentProfile[]
  materials Material[]

  @@map("courses")
}

model Plan {
  id              String  @id @default(uuid())
  name            String
  price           Decimal @db.Decimal(10, 2)
  lessonsPerMonth Int
  description     String?
  active          Boolean @default(true)

  students StudentProfile[]

  @@map("plans")
}

model TeacherProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialties   String[]
  availability  Json? // { mon: ["09:00-12:00"], tue: [...] }
  hourlyRate    Decimal  @db.Decimal(10, 2)
  // History of hourlyRate changes over time, same shape/sync rule as
  // StudentProfile.monthlyValueHistory — hourlyRate always mirrors
  // whichever entry is in effect today (or the most recent one), kept in
  // sync on every edit. Record-keeping only; no calculation currently
  // resolves a rate for a specific past month.
  hourlyRateHistory Json @default("[]")
  // Deprecated — no longer collected at cadastro; actual monthly class load
  // is computed instead (see server/queries/teachers.ts). Kept only so
  // existing rows don't need a backfill; new rows just get the default.
  weeklyHours   Int      @default(0)
  admissionDate DateTime
  // Optional — this teacher's employment end date, if known.
  endDate       DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  students StudentProfile[] @relation("StudentProfile_teacher")
  lessons  Lesson[]

  @@map("teacher_profiles")
}

model StudentProfile {
  id                String          @id @default(uuid())
  userId            String          @unique
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Set only for a "grupo" cadastro — a name for the group itself (e.g. a
  // family or company name) so it can be found later by that, not just by
  // the primary member's name. Null for an ordinary individual student.
  groupName         String?
  cpf               String?         @unique
  birthDate         DateTime?
  address           String?
  // Google Meet (or any video call) link for this student's classes — set
  // once on the cadastro instead of per lesson, shown as a "Entrar na aula"
  // button when a teacher or the student opens a class on their calendar.
  meetLink          String?
  teacherId         String?
  teacher           TeacherProfile? @relation("StudentProfile_teacher", fields: [teacherId], references: [id])
  // History of teacher changes — [{ "id": "<teacherId>", "from": "...", "until": "..." }, ...].
  // teacherId always mirrors whichever entry is in effect today (or the
  // most recent one), and syncRecurringLessons resolves the
  // historically-correct teacher per generated lesson from this instead.
  teacherHistory    Json            @default("[]")
  courseId          String?
  course            Course?         @relation(fields: [courseId], references: [id])
  // Record of past courses, same shape as teacherHistory — informational
  // only, doesn't drive any generation logic.
  courseHistory     Json            @default("[]")
  planId            String?
  plan              Plan?           @relation(fields: [planId], references: [id])
  // Record of past plans, same shape as teacherHistory — informational
  // only, doesn't drive any generation logic.
  planHistory       Json            @default("[]")
  monthlyValue      Decimal         @db.Decimal(10, 2)
  // History of monthlyValue changes over time —
  // [{ "amount": 141.02, "from": "2026-01-01", "until": "2026-06-30" }, ...].
  // monthlyValue always mirrors whichever entry is in effect today (or the
  // most recent one with no "until"), kept in sync on every edit, so
  // simple aggregate queries (dashboards, CSV) keep reading a flat number;
  // getBillingSlots resolves the historically-correct amount for a given
  // reference month from this instead when generating/previewing cobranças.
  monthlyValueHistory Json          @default("[]")
  bankAccount       BankAccount     @default(JOE) // which of the school's 3 accounts receives this student's payments
  dueDay            Int             @default(10) // day of the month the invoice ("boleto") is due, 1-31
  // History of dueDay changes over time, same shape/sync rule as
  // monthlyValueHistory — dueDay always mirrors whichever entry is in
  // effect today (or the most recent one); getBillingSlots resolves the
  // historically-correct due day for a given reference month from this.
  dueDayHistory     Json            @default("[]")
  // Optional third-party payer (e.g. a company) covering part or all of
  // monthlyValue, billed separately with its own due date. Null name means
  // no third party is configured — the student is billed the full amount.
  thirdPartyPayerName String?
  thirdPartyAmount     Decimal?      @db.Decimal(10, 2)
  thirdPartyDueDay     Int? // 1-31
  thirdPartyBankAccount BankAccount? // which account receives the third party's portion
  lessonsPerMonth   Int             @default(4)
  // History of lessonsPerMonth changes over time, same shape/sync rule as
  // monthlyValueHistory — informational record-keeping only, like
  // teacherHistory/courseHistory/planHistory (doesn't drive any
  // calculation, since actual monthly class load is computed from the
  // real generated lessons instead).
  lessonsPerMonthHistory Json       @default("[]")
  // One entry per scheduled day, each with its own time:
  // [{ "weekday": 2, "start": "19:00", "end": "19:50" }, ...] (weekday 0=Sun..6=Sat)
  lessonSchedule    Json            @default("[]")
  level             CourseLevel     @default(A1)
  levelProgress     Int             @default(0) // 0-100
  lessonsContracted Int             @default(0)
  startDate         DateTime        @default(now())
  // Optional — when billing should start counting a student as billable,
  // independent of when their classes actually started (startDate). Falls
  // back to startDate when unset. Exists because the two can genuinely
  // differ — e.g. a class held on the last day of a month whose first
  // charge is only due the 1st of the next one.
  billingStartDate  DateTime?
  // Optional — when set, recurring lesson generation never schedules a
  // class past this date, and it's shown as the course's expected end.
  endDate           DateTime?
  objective         String?
  notes             String?
  status            StudentStatus   @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  lessons          Lesson[]
  payments         Payment[]
  levelHistory     LevelHistory[]
  certificates     Certificate[]
  quizAttempts     QuizAttempt[]
  achievements     StudentAchievement[]
  leadInteractions LeadInteraction[]
  alertDismissals  StudentAlertDismissal[]
  // Additional people sharing this one course/billing (a "grupo" student) —
  // each gets their own separate login but sees the exact same shared
  // profile (lessons, progress, billing) once signed in. The main
  // user/userId above is just the first/primary member; empty for an
  // ordinary individual student.
  groupMembers     StudentGroupMember[]

  @@map("student_profiles")
}

// One additional login for a "grupo" student, beyond the primary
// user/userId on StudentProfile — e.g. each participant in a family or
// corporate account that shares one course and one bill but wants their
// own username/password. Deleting the member's User cascades this row
// away (see deleteStudent/removeStudentGroupMember, which delete the User
// first); deleting the StudentProfile itself cascades this row away too,
// but callers must still delete each member's own User/Supabase Auth
// account explicitly first or it's left dangling with no profile to
// resolve to.
model StudentGroupMember {
  id               String         @id @default(uuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  userId           String         @unique
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@map("student_group_members")
}

// Marks the point in time a coordinator/admin last reviewed and dismissed
// this student's attendance alert (2+ CA/NC/CP in a month, or 2 in a row).
// Only lessons after the latest dismissal count toward re-triggering it, so
// resolving an alert clears it without erasing the lessons that caused it.
model StudentAlertDismissal {
  id          String         @id @default(uuid())
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  note        String?
  dismissedBy String // actor name snapshot
  dismissedAt DateTime       @default(now())

  @@index([studentId])
  @@map("student_alert_dismissals")
}

model LevelHistory {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromLevel  CourseLevel
  toLevel    CourseLevel
  promotedBy String // userId
  notes      String?
  createdAt  DateTime       @default(now())

  @@map("level_history")
}

// ---------------------------------------------------------------------------
// Lessons / agenda / reports
// ---------------------------------------------------------------------------

model Lesson {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  scheduledAt DateTime
  durationMin Int          @default(50)
  status      LessonStatus @default(SCHEDULED)
  // True for lessons auto-generated from the student's weekly schedule, so
  // regenerating that schedule never touches manually-booked lessons
  // (makeups, one-off extra classes, etc).
  isRecurring Boolean      @default(false)

  // Set on the NEW (makeup) lesson created via the "Reagendamento" picker
  // when a lesson is canceled (CA/CP/CF) — points back to the lesson it
  // replaces. Optional 1:1 self-relation.
  rescheduledFromId String?  @unique
  rescheduledFrom   Lesson?  @relation("LessonReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo     Lesson?  @relation("LessonReschedule")

  // post-lesson report (filled by teacher)
  contentTaught String? // free text, or a picked curriculum unit label ("Aula 12", "Teste 3")
  classFocus    String? // Revisão / Conversação / Etapa 1-3 / Gramática
  vocabulary    String?
  grammar       String?
  speaking      String?
  listening     String?
  homework      String?
  observations  String?
  difficulties  String?
  nextTopics    String?
  materialUsed  String?
  recordingUrl  String?
  reportedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([scheduledAt])
  @@map("lessons")
}

// ---------------------------------------------------------------------------
// Financial
// ---------------------------------------------------------------------------

model Payment {
  id             String         @id @default(uuid())
  studentId      String
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  referenceMonth DateTime // first day of the reference month
  amount         Decimal        @db.Decimal(10, 2)
  dueDate        DateTime
  paidAt         DateTime?
  status         PaymentStatus  @default(PENDING)
  method         String? // pix, boleto, card... (prepared for gateway integration)
  // Null = billed to the student themselves. Otherwise the name of the
  // third party (e.g. a company) this specific charge is billed to — a
  // student can have up to two Payment rows per month, one per payer.
  payerName      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([studentId])
  @@index([status])
  @@map("payments")
}

enum ExpenseFrequency {
  ONE_TIME
  RECURRING
}

enum ExpenseCategory {
  PROFESSORES
  MARKETING
  PARCEIROS
  OUTROS
}

model Expense {
  id          String           @id @default(uuid())
  description String
  amount      Decimal          @db.Decimal(10, 2)
  frequency   ExpenseFrequency
  category    ExpenseCategory  @default(OUTROS)
  // ONE_TIME: the date it happened/is due.
  // RECURRING: the date the recurring obligation started.
  date        DateTime
  dayOfMonth  Int? // RECURRING only: day of month it's due, 1-31
  // RECURRING only: when it stopped recurring — null means still ongoing.
  endDate     DateTime?
  bankAccount BankAccount      @default(JOE) // which account this gasto is paid from
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Audit log (append-only, never delete)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String      @id @default(uuid())
  entityType String // "StudentProfile", "TeacherProfile", "Lesson", ...
  entityId   String
  action     AuditAction
  // Actor is denormalized (no FK) on purpose: audit rows must never
  // disappear or become unwritable even after the acting user's account
  // is deleted, so we snapshot their identity instead of joining live.
  actorId    String
  actorName  String
  actorEmail String
  actorRole  Role
  changes    Json? // diff snapshot { field: [old, new] }
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// CRM educacional (funil de vendas) — prepared for the sales/retention flow
// ---------------------------------------------------------------------------

model Lead {
  id                 String    @id @default(uuid())
  name               String
  email              String?
  phone              String?
  stage              LeadStage @default(LEAD)
  source             String?
  notes              String?
  convertedStudentId String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  interactions LeadInteraction[]

  @@map("leads")
}

model LeadInteraction {
  id        String          @id @default(uuid())
  leadId    String
  lead      Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  studentId String?
  student   StudentProfile? @relation(fields: [studentId], references: [id])
  authorId  String
  author    User            @relation("InteractionAuthor", fields: [authorId], references: [id])
  channel   String // call, whatsapp, email, in-person
  summary   String
  createdAt DateTime        @default(now())

  @@map("lead_interactions")
}

// ---------------------------------------------------------------------------
// Prepared for future modules (materials library, quizzes, certificates,
// gamification) — schemas ready so these can be built without migrations.
// ---------------------------------------------------------------------------

model Material {
  id        String       @id @default(uuid())
  title     String
  type      String // pdf, video, audio
  url       String
  level     CourseLevel?
  courseId  String?
  course    Course?      @relation(fields: [courseId], references: [id])
  createdAt DateTime     @default(now())

  @@map("materials")
}

model Quiz {
  id        String       @id @default(uuid())
  title     String
  level     CourseLevel?
  createdAt DateTime     @default(now())

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  id      String @id @default(uuid())
  quizId  String
  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt  String
  options Json // string[]
  answer  Int // index into options

  @@map("quiz_questions")
}

model QuizAttempt {
  id        String         @id @default(uuid())
  quizId    String
  quiz      Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score     Int
  takenAt   DateTime       @default(now())

  @@map("quiz_attempts")
}

model Certificate {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level     CourseLevel
  issuedAt  DateTime       @default(now())
  fileUrl   String?

  @@map("certificates")
}

model Achievement {
  id          String  @id @default(uuid())
  name        String
  description String?
  icon        String?
  points      Int     @default(0)

  students StudentAchievement[]

  @@map("achievements")
}

model StudentAchievement {
  id            String         @id @default(uuid())
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement    @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  earnedAt      DateTime       @default(now())

  @@map("student_achievements")
}
